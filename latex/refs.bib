﻿@Article{Hyun2022,
author={Hyun, Jason C.
and others},
title={Comparative pangenomics: analysis of 12 microbial pathogen pangenomes reveals conserved global structures of genetic and functional diversity},
journal={BMC Genomics},
year={2022},
